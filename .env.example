# Hammerhead API (masterplan §2.6.2)
#
# Get these from dashboard.hammerhead.io:
#   1. Sign in and enable developer settings on your account.
#   2. Give the app a name, a description and an SVG logo.
#   3. Accept the API licence agreement.
#      Licence questions: hammerhead.integrations@sram.com
#   4. Open the API settings tab — client id, secret and redirect URLs are there.
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored;
# nothing in the app writes these to the database or renders them on screen.
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=

# Must match one of the Redirect URLs registered in your API settings.
# Try this one first: if Hammerhead accepts it, the browser returns straight
# to the app and the connection completes on its own. If the field rejects a
# plain-http or LAN address, register whatever it does accept — you will then
# be redirected somewhere else and paste that URL into the Settings card,
# which runs the same exchange.
HAMMERHEAD_REDIRECT_URI=http://localhost:3000/settings/hammerhead/callback

# Optional. The scheduler does not run under `reflex run` (dev mode), because
# the backend restarts on every file save and would fire a burst of API calls
# each time. Set this to 1 when the poller itself is what you are working on.
# "Poll now" in Settings works regardless.
# BIKE_TRACKER_POLL_IN_DEV=1

# Optional. Only for pointing the client at a local fake; the tests set these
# themselves.
# HAMMERHEAD_AUTH_BASE=https://api.hammerhead.io/v1/auth
# HAMMERHEAD_API_BASE=https://api.hammerhead.io/v1/api
